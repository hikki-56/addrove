# ============================================================
# Stockify Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# Configure independent values for Vercel Preview and Production.
# ============================================================

# ---- Authentication ----
# Generate independent random values of at least 32 characters per environment.
# AUTH_SECRET and QR_TOKEN_SECRET must be different from each other.
# Example: openssl rand -hex 32
AUTH_SECRET=
QR_TOKEN_SECRET=

# ---- Application URLs ----
# Outside local development, both MUST be HTTPS URLs.
# Use a stable Preview URL in Preview and the canonical domain in Production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ---- Google Sheets Storage ----
# The Spreadsheet ID from the Google Sheets URL.
# Preview and Production must use different spreadsheets.
GOOGLE_SHEET_ID=

# Service Account credentials for authenticated reads and writes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---- Google Apps Script Writer ----
# The Web App URL deployed from scripts/google-apps-script.gs.
# If configured, it must point to the Apps Script deployment for this environment.
GOOGLE_SCRIPT_URL=

# HMAC-SHA256 signing secret shared between Vercel and Apps Script.
# Required whenever GOOGLE_SCRIPT_URL is set. It must be at least 32 characters,
# distinct from AUTH_SECRET and QR_TOKEN_SECRET, and unique per environment.
# The same value must be stored in the
# Apps Script's Script Properties under the key "SIGNING_SECRET".
# Generate: openssl rand -hex 32
GOOGLE_SCRIPT_SIGNING_SECRET=

# Local-development compatibility for an older Apps Script deployment.
# Never enable this in Preview or Production.
GOOGLE_SCRIPT_LEGACY_MODE=false

# ---- Optional ----
# Read-only API key fallback for fast public sheet reads.
GOOGLE_API_KEY=

# Only while generating initial password hashes with scripts/seed-users.ts.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_VIEWER_PASSWORD=
SEED_MANAGER_PASSWORD=
