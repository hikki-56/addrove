# ============================================================
# Stockify Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# ============================================================

# ---- Authentication ----
# Generate independent random values of at least 32 characters for production.
# Example: openssl rand -hex 32
AUTH_SECRET=
QR_TOKEN_SECRET=

# ---- Application URLs ----
# In production, both MUST be HTTPS URLs (e.g. https://stockify.example.com)
# NEXTAUTH_URL must NOT point to localhost in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ---- Google Sheets Storage ----
# The Spreadsheet ID from the Google Sheets URL.
GOOGLE_SHEET_ID=

# Service Account credentials for authenticated reads and writes.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ---- Google Apps Script Writer ----
# The Web App URL deployed from scripts/google-apps-script.gs.
# Required in production for distributed-lock-safe stock mutations.
GOOGLE_SCRIPT_URL=

# HMAC-SHA256 signing secret shared between Vercel and Apps Script.
# Must be at least 32 characters. The same value must be stored in the
# Apps Script's Script Properties under the key "SIGNING_SECRET".
# Generate: openssl rand -hex 32
GOOGLE_SCRIPT_SIGNING_SECRET=

# ---- Optional ----
# Read-only API key fallback for fast public sheet reads.
GOOGLE_API_KEY=

# Only while generating initial password hashes with scripts/seed-users.ts.
SEED_ADMIN_PASSWORD=
SEED_STAFF_PASSWORD=
SEED_VIEWER_PASSWORD=
