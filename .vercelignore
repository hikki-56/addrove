# Vercel deploy ignore — keep the bundle lean

# Environment variables and local credentials (except the empty example template)
.env*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Local data and files that may contain PII
data/
data/**
*.log

# Temporary and research folders
.tmp*
.temp*
scratch/
scratch/**

# Testing and coverage files not required at runtime
__tests__/
*.test.ts
*.test.tsx
coverage/
jest.config.js

# Build and IDE artifacts
.vercel/
.next/cache/
*.tsbuildinfo
.idea/
.vscode/

# Documentation (optional — not needed at runtime)
docs/

# Scripts not needed at runtime
scripts/seed-users.ts
scripts/test-csv.ts
